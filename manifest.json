{
  "manifest_version": 3,
  "name": "身后名 Legacy Clean",
  "version": "1.0.0",
  "description": "连续 N 天未使用浏览器时，自动清空历史并伪造积极正面的浏览记录（默认干跑模式，可自定义触发天数与伪造内容）",
  "permissions": ["history", "storage", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "身后名 Legacy Clean"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
